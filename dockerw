notice() {
    echo "-- $0: $@"
}

set -e

if [ -f /.dockerenv ]; then
    echo "ERROR: dockerw is already running inside a container."
    echo "Run commands directly in the current container instead of nesting containers."
    exit 1
fi

COMPOSE_INTERACTIVE_FLAGS=""
EXTRA_ENV="-e SSH_AUTH_SOCK"
DEV_VOL=""
HOST_NETWORK=""
USE_REMOTE_RADIOS=false

DIR=$(pwd)

while getopts ":ne:dHT" opt; do
    case ${opt} in
    n) # process option n
        COMPOSE_INTERACTIVE_FLAGS="--no-TTY"
        ;;
    e) # extra environment variables
        EXTRA_ENV="${EXTRA_ENV} -e ${OPTARG}"
        ;;
    d) # add /dev volume mapping
        DEV_VOL="-v /dev:/dev"
        ;;
    H) # use host networking (useful for Matter device access)
        HOST_NETWORK="1"
        ;;
    T) # spin up the remote-radios container (Silabs Zigbee/Thread + Bluetooth dongle)
        USE_REMOTE_RADIOS=true
        ;;
    esac
done
shift "$(($OPTIND - 1))"

# Host networking puts the container in the dev server's own network namespace,
# where Matter's mDNS reaches every developer's Docker networks — including
# their border routers — and the per-user radios network is bypassed.
if [ "$USE_REMOTE_RADIOS" = true ] && [ -n "$HOST_NETWORK" ]; then
    echo "dockerw: -T (remote radios) cannot be combined with -H (host networking)." >&2
    echo "dockerw: host networking would expose other developers' Thread devices to Matter discovery." >&2
    exit 1
fi

# generate the `docker/.env` file and ensure the network/image is created
REMOTE_RADIOS_REQUESTED="$USE_REMOTE_RADIOS" $DIR/docker/setupDockerEnv.sh

# The remote-radios container lives in its own Compose project, deliberately
# separate from the barton one.  It is long-lived and shared by several
# projects, whereas the overlay that defines it is only layered in for `-T`.
# Were it part of the barton project, every plain `./dockerw` would report it as
# an orphan and invite `--remove-orphans`, which would tear the radios out from
# under BartonCore, ZigbeeCore and zilker at once.
#
# The project is per user, not per workspace: the radio sockets it consumes are
# per user, so all of a user's BartonCore workspaces share one radios stack.
RADIOS_PROJECT="$(. "${DIR}/docker/.env" >/dev/null 2>&1; \
    printf '%s-remote-radios' "${BUILDER_USER}")"

COMPOSE_FILES=(-f "${DIR}/docker/compose.yaml")
if [ "$USE_REMOTE_RADIOS" = true ]; then
    COMPOSE_FILES+=(-f "${DIR}/docker/compose.remote-radios.yaml")
fi
# `docker compose run` has no `--network` flag, so host networking is applied by
# layering the host-network override compose file (which sets network_mode: host
# and resets the base network) rather than passing a flag to the run command.
if [ -n "$HOST_NETWORK" ]; then
    COMPOSE_FILES+=(-f "${DIR}/docker/compose.host-network.yaml")
fi

EXTRA_VOLUMES="${DEV_VOL}"

VOLUMES_ARGS="-v $HOME:$HOME
             $EXTRA_VOLUMES"

# If the -T flag was given, build and start the remote-radios container in the
# background before opening the barton shell.  The container runs cpcd and
# otbr-agent.
#
# Barton reaches both Bluetooth and Thread over the dev server's own system
# bus: org.bluez comes from the server's shared bluetoothd, and this
# developer's border router registers there under its own interface name.  See
# docs/REMOTE_RADIO_FOR_DEVELOPMENT.md.
if [ "$USE_REMOTE_RADIOS" = true ]; then
    # Start the user's radios stack if it is not already running, but never
    # recreate a running one.  Another of the user's workspaces may own it, and
    # its compose files can differ from this workspace's, which would otherwise
    # make Compose tear down working radios to "update" them.
    radiosId="$(docker compose -p "$RADIOS_PROJECT" "${COMPOSE_FILES[@]}" ps -q remote-radios 2>/dev/null)"
    if [ -n "$radiosId" ] && [ "$(docker inspect -f '{{.State.Running}}' "$radiosId" 2>/dev/null)" = true ]; then
        notice "Using running remote-radios container ($(docker inspect -f '{{.Name}}' "$radiosId" | sed 's#^/##'))."
    else
        notice "Starting remote-radios container (cpcd + otbr-agent)..."
        docker compose -p "$RADIOS_PROJECT" "${COMPOSE_FILES[@]}" up -d --no-recreate remote-radios
        notice "remote-radios container started in the background."
        radiosId="$(docker compose -p "$RADIOS_PROJECT" "${COMPOSE_FILES[@]}" ps -q remote-radios 2>/dev/null)"
    fi

    # `up -d` only waits for the container to run.  Give otbr-agent time to
    # claim its bus name so Barton's first Thread attempt finds it; Barton
    # also reconnects and retries on its own, so a timeout is not fatal.
    radiosWait="${REMOTE_RADIOS_READY_WAIT_SECONDS:-60}"
    [[ "$radiosWait" =~ ^[0-9]+$ ]] || radiosWait=60
    radiosReady=false
    radiosDeadline=$((SECONDS + radiosWait))
    radiosWaitNoticed=false
    while [ "$SECONDS" -lt "$radiosDeadline" ]; do
        if timeout 5 docker exec "$radiosId" sh -c \
            'DBUS_SYSTEM_BUS_ADDRESS="unix:path=${HOST_DBUS_SOCKET:-/run/host-dbus/system_bus_socket}" \
             dbus-send --system --reply-timeout=2000 --print-reply --dest=org.freedesktop.DBus / \
             org.freedesktop.DBus.NameHasOwner \
             string:"io.openthread.BorderRouter.${THREAD_INTERFACE:-wpan0}"' 2>/dev/null |
            grep -q 'boolean true'; then
            radiosReady=true
            break
        fi
        if [ "$radiosWaitNoticed" = false ]; then
            notice "Waiting up to ${radiosWait}s for otbr-agent on D-Bus..."
            radiosWaitNoticed=true
        fi
        sleep 1
    done
    if [ "$radiosReady" = true ]; then
        notice "otbr-agent is ready."
    else
        notice "otbr-agent is not on D-Bus yet; Barton will keep retrying. Check: docker logs $radiosId"
    fi
    EXTRA_ENV="${EXTRA_ENV} -e DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/host-dbus/system_bus_socket"

    # Zigbee comes from ZigbeeCore's remote-zigbee container, set up from a
    # ZigbeeCore checkout with scripts/remote-zigbee.sh, which records where
    # that checkout is.  Start the container if it is not running, and point
    # Barton at it.
    ZIGBEE_HINT="${HOME}/.remote-radios/zigbee.env"
    zigbeeContainer="$(id -un)-remote-zigbee"
    if [ -f "$ZIGBEE_HINT" ]; then
        zigbeeDir="$(sed -n 's/^ZIGBEECORE_DIR=//p' "$ZIGBEE_HINT")"
        zigbeeRun="$(sed -n 's/^RUN_ZIGBEECORE=//p' "$ZIGBEE_HINT")"
        if [ "$(docker inspect -f '{{.State.Running}}' "$zigbeeContainer" 2>/dev/null)" = true ]; then
            notice "Using running remote-zigbee container (${zigbeeContainer})."
        elif [ -x "${zigbeeDir}/scripts/remote-zigbee.sh" ]; then
            notice "Starting remote-zigbee container from ${zigbeeDir}..."
            if [ "$zigbeeRun" = 0 ]; then
                "${zigbeeDir}/scripts/remote-zigbee.sh" up --dev >/dev/null
            else
                "${zigbeeDir}/scripts/remote-zigbee.sh" up >/dev/null
            fi
        else
            notice "Zigbee unavailable: ${ZIGBEE_HINT} names ${zigbeeDir}, which has no scripts/remote-zigbee.sh."
        fi
        # Barton accepts only a numeric address for ZigbeeCore (it trusts events
        # by comparing their source to it), so pass the container's address on
        # the radios network.  If the container is recreated with a new
        # address, restart Barton's container.
        radiosNetwork="$(. "${DIR}/docker/.env" >/dev/null 2>&1; printf '%s-remote-radios' "${BUILDER_USER}")"
        zigbeeIp="$(docker inspect -f "{{with index .NetworkSettings.Networks \"${radiosNetwork}\"}}{{.IPAddress}}{{end}}" \
            "$zigbeeContainer" 2>/dev/null)"
        if [ -n "$zigbeeIp" ]; then
            notice "ZigbeeCore is at ${zigbeeIp} on ${radiosNetwork}."
            EXTRA_ENV="${EXTRA_ENV} -e ZIGBEE_CORE_IP=${zigbeeIp}"
        else
            notice "Zigbee unavailable: ${zigbeeContainer} has no address on ${radiosNetwork}; run Barton with -z."
        fi
    else
        notice "Zigbee is not set up; run Barton with -z, or set it up from a ZigbeeCore checkout:"
        notice "    scripts/remote-zigbee.sh up"
    fi
fi

# create a unique container name prefixed with the user id, useful when on a shared machine
USER_ID=$(id -u -n)
RANDOM_NUMBER=$(shuf -i 100000-999999 -n 1)
CONTAINER_NAME="${USER_ID}_${RANDOM_NUMBER}"

# With remote radios, install the route to this developer's Thread network
# before running the requested command (bash by default).  The VS Code
# devcontainer does the same from its postStartCommand.
RUN_CMD=("$@")
if [ "$USE_REMOTE_RADIOS" = true ]; then
    [ ${#RUN_CMD[@]} -gt 0 ] || RUN_CMD=(bash)
    # The radios container publishes which Bluetooth adapter is this
    # developer's; hand it to Barton unless the caller chose one.
    RUN_CMD=(bash -c 'docker/setup-thread-routes.sh >&2 || true
        f=/var/run/remote-radios-dbus/ble_adapter_id
        if [ -z "${BARTON_BLE_ADAPTER_ID:-}" ] && [ -r "$f" ]; then
            BARTON_BLE_ADAPTER_ID="$(tr -d "[:space:]" < "$f")"
            export BARTON_BLE_ADAPTER_ID
        fi
        exec "$@"' dockerw "${RUN_CMD[@]}")
fi

# --use-aliases: `run` otherwise ignores the service's network aliases, and
# ZigbeeCore's remote-zigbee container reaches Barton by its alias, barton.
docker compose "${COMPOSE_FILES[@]}" run \
    --rm \
    --use-aliases \
    --name ${CONTAINER_NAME} \
    ${COMPOSE_INTERACTIVE_FLAGS} \
    --workdir "${DIR}" \
    ${VOLUMES_ARGS} \
    ${EXTRA_ENV} \
    barton \
    "${RUN_CMD[@]}"
